{
  "hosting": {
    "public": "hosting/public",
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/join/**",
        "destination": "/join.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/app/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/app/@(index.html|flutter_bootstrap.js|manifest.json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/:app(App|APP|apps|Apps|APPS|webapp|web)",
        "destination": "/app/",
        "type": 301
      },
      {
        "source": "/:app(App|APP|apps|Apps)/:rest*",
        "destination": "/app/",
        "type": 301
      },
      {
        "source": "/:join(Join|JOIN)/:token",
        "destination": "/join/:token",
        "type": 301
      }
    ]
  }
}
