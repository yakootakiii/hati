<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar icon: the Hati mark (two halves of a disc, slid apart) in a
     single colour, which Android tints. Drawn on a 24dp grid. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Left half, slid down. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.9,3.9 A8.2,8.2 0 0,0 10.9,20.3 Z" />
    <!-- Right half, slid up. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13.1,1.7 A8.2,8.2 0 0,1 13.1,18.1 Z" />
</vector>
