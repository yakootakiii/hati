# Copy to .env and fill from the Supabase dashboard (Project Settings → API).
# The publishable key is safe to ship in a client build; RLS is what protects
# the data. Run with:  flutter run --dart-define-from-file=.env
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# Web push (D-72): Firebase → Project settings → Cloud Messaging → Web Push
# certificates → the key pair. Public by design; only the web app uses it.
FIREBASE_VAPID_KEY=<web-push-public-key>
